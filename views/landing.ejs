<section class="py-4 py-xl-5">
    <section class="py-4 py-xl-5">
        <div class="container">
            <div class="text-center p-4 p-lg-5">
                <p class="fw-bold text-primary mb-2"></p>
                <h1 class="fw-bold mb-4">Empowering Your Health, One Dose at a Time</h1>
                <p>Welcome to Pillpal – your decentralized app for secure medication management. With our cutting-edge technology, your health data stays protected while you take charge of your well-being effortlessly.</p><button class="btn btn-primary fs-5 me-2 py-2 px-4" type="button" id="login1" onclick="connectMetamask()">Connect wallet</button>
            </div>
        </div>
    </section>
    <div class="container py-4 py-xl-5">
        <div class="row">
            <div class="col-md-8 col-xl-6 mx-auto p-4">
                <div class="d-flex align-items-center align-items-md-start align-items-xl-center">
                    <div class="bs-icon-xl bs-icon-circle bs-icon-primary d-flex flex-shrink-0 justify-content-center align-items-center me-4 d-inline-block bs-icon xl"><i class="fas fa-pills"></i></div>
                    <div>
                        <h4>Medication Tracker</h4>
                        <p>Track your medication schedule with ease. Set reminders for your pills and never miss a dose. Keep detailed records of your medication intake and easily share them with your healthcare provider for better management of your health.</p>
                        <a href="#">Learn More&nbsp;<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" class="bi bi-arrow-right">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"></path>
                        </svg></a>
                    </div>
                </div>
                <hr class="my-5">
                <div class="d-flex align-items-center align-items-md-start align-items-xl-center">
                    <div class="bs-icon-xl bs-icon-circle bs-icon-primary d-flex flex-shrink-0 justify-content-center align-items-center order-last ms-4 d-inline-block bs-icon xl"><i class="fas fa-money-bill-wave"></i></div>
                    <div>
                        <h4>Send and Receive ETH</h4>
                        <p>Easily send and receive Ether (ETH) to manage your transactions securely and efficiently. Seamlessly integrated ETH transactions in this DApp, For better overall user experience.</p>
                        <a href="#">Learn More&nbsp;<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" class="bi bi-arrow-right">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"></path>
                        </svg></a>
                    </div>
                </div>
                <hr class="my-5">
                <div class="d-flex align-items-center align-items-md-start align-items-xl-center">
                    <div class="bs-icon-xl bs-icon-circle bs-icon-primary d-flex flex-shrink-0 justify-content-center align-items-center me-4 d-inline-block bs-icon xl"><i class="fas fa-chart-line"></i></div>
                    <div>
                        <h4>Dashboard</h4>
                        <p>Access a comprehensive dashboard to monitor your medication intake and financial transactions. Analyze your medication adherence over time and track your spending related to healthcare expenses for better budgeting and planning.</p>
                        <a href="#">Learn More&nbsp;<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" class="bi bi-arrow-right">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"></path>
                        </svg></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    
    <section class="position-relative py-5">
        <div class="d-md-none"><iframe allowfullscreen="" frameborder="0" src="https://cdn.bootstrapstudio.io/placeholders/map.html" width="100%" height="100%"></iframe></div>
        <div class="d-none d-md-block position-absolute top-0 start-0 w-100 h-100">
            <gmp-map center="53.34931182861328,-6.243282318115234" zoom="17" map-id="DEMO_MAP_ID">
                <gmp-advanced-marker position="53.34931182861328,-6.243282318115234" title="My location"></gmp-advanced-marker>
              </gmp-map>
        </div> 
        
        <div class="position-relative mx-2 my-5 m-md-5">
            <div class="container position-relative">
                <div class="row">
                    <div class="col-md-5">
                        <div>
                            <form class="border rounded shadow p-2 p-md-3 p-lg-4" method="post" action="/sendmail" style="background: var(--bs-body-bg);">
                                <h3 class="text-center mb-3">Contact us</h3>
                                <div class="mb-3"><input class="form-control" type="text" name="name" placeholder="Name"></div>
                                <div class="mb-3"><input class="form-control" type="email" name="email" placeholder="Email"></div>
                                <div class="mb-3"><textarea class="form-control" name="message" placeholder="Message" rows="6"></textarea></div>
                                <div class="mb-3"><button class="btn btn-primary" type="submit">Send </button></div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
