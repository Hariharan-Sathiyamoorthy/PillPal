<%- include header.ejs %>

    <section class="py-4 py-xl-5">
        <div class="container mb-4">
            <div class="row">
                <div class="col-md-12">

                    <div class="card">
                        <div class="card-body">
                            
                            <form  >
                                <div class="form-group">
                                    <label for="formGroupExampleInput">Account</label>
                                    <input type="text" class="form-control" id="formGroupAccount" name="account"
                                        placeholder="Example input" readonly>
                                </div>
                                <div class="form-group">
                                    <label for="formGroupExampleInput">Drug Name</label>
                                    <input type="text" class="form-control" id="formGroupExampleInput" name="dosageName"
                                        placeholder="Example input">
                                </div>
                                <div class="form-group">
                                    <label for="formGroupExampleInput2">Dosage in mg</label>
                                    <input type="number" class="form-control" id="formGroupExampleInput2"
                                        name="dosageDose" placeholder="Another input">
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-10">
                                        <button type="button" onclick="addMedication()" class="btn btn-primary">Add to blockChain</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>

    <% include footer.ejs %>